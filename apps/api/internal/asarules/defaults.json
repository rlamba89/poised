{
  "noGradeAutoTriage": true,
  "messageAfterCheck": false,
  "rules": [
    {
      "id": "low_risk",
      "name": "Low risk",
      "when": { "asa": { "op": "<=", "grade": 2 }, "noRedFlags": true, "notBand": { "score": "stopbang_score", "bands": ["b_high"] } },
      "then": [{ "kind": "autoTriage", "target": "ready_for_admission" }]
    },
    {
      "id": "high_risk",
      "name": "High risk",
      "when": { "asa": { "op": ">=", "grade": 3 } },
      "then": [
        { "kind": "task", "title": "Book anaesthetic review", "team": "anaesthetist" },
        { "kind": "flag", "name": "Anaesthetic review" },
        { "kind": "requireAnaesthetistAsa" }
      ]
    }
  ],
  "testCases": []
}
