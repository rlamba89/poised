        {
          "type": "expression",
          "name": "morse_score",
          "title": "Morse Fall Scale score",
          "calcKind": "score",
          "expression": "iif(allAnswered('morse_falls', 'morse_secondary', 'morse_aid', 'morse_iv', 'morse_gait', 'morse_mental'), score('morse_falls', 'morse_secondary', 'morse_aid', 'morse_iv', 'morse_gait', 'morse_mental'), '')",
          "bands": [
            {
              "id": "b_low",
              "label": "Low risk",
              "max": 24
            },
            {
              "id": "b_moderate",
              "label": "Moderate risk",
              "max": 44
            },
            {
              "id": "b_high",
              "label": "High risk"
            }
          ]
        }
      ]
