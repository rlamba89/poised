              "title": "DASI score",
              "clinicianOnly": true,
              "calcKind": "score",
              "expression": "iif(allAnswered('dasi_selfcare', 'dasi_walk_indoors', 'dasi_walk_block', 'dasi_stairs', 'dasi_run', 'dasi_light_work', 'dasi_moderate_work', 'dasi_heavy_work', 'dasi_yardwork', 'dasi_sexual', 'dasi_moderate_recreation', 'dasi_strenuous_sports'), round(score('dasi_selfcare', 'dasi_walk_indoors', 'dasi_walk_block', 'dasi_stairs', 'dasi_run', 'dasi_light_work', 'dasi_moderate_work', 'dasi_heavy_work', 'dasi_yardwork', 'dasi_sexual', 'dasi_moderate_recreation', 'dasi_strenuous_sports'), 2), '')",
              "bands": [
                {
                  "id": "b_poor",
                  "label": "Poor functional capacity",
                  "max": 34
                }
              ]
            },
            {
              "type": "expression",
              "name": "dasi_mets",
              "title": "DASI METs",
              "clinicianOnly": true,
              "calcKind": "custom",
              "expression": "iif({dasi_score} notempty, round((0.43 * {dasi_score} + 9.6) / 3.5, 1), '')",
              "format": "{0} METs",
              "displayStyle": "decimal",
              "minimumFractionDigits": 1,
              "maximumFractionDigits": 1
            }
          ]
        }
