        {
          "type": "expression",
          "name": "vte_score",
          "title": "Thrombosis risk factors",
          "calcKind": "score",
          "expression": "iif(allAnswered('vte_cancer', 'vte_dehydration', 'vte_thrombophilia', 'vte_comorbidity', 'vte_history', 'vte_hrt', 'vte_contraceptive', 'vte_varicose', 'vte_pregnancy', 'vte_mobility', 'vte_hip_knee', 'vte_hip_fracture', 'vte_time_90', 'vte_pelvis_60', 'vte_acute_surgical', 'vte_critical_care', 'vte_surgery_mobility', 'patientAge', 'vte_bmi'), score('vte_cancer', 'vte_dehydration', 'vte_thrombophilia', 'vte_comorbidity', 'vte_history', 'vte_hrt', 'vte_contraceptive', 'vte_varicose', 'vte_pregnancy', 'vte_mobility', 'vte_hip_knee', 'vte_hip_fracture', 'vte_time_90', 'vte_pelvis_60', 'vte_acute_surgical', 'vte_critical_care', 'vte_surgery_mobility') + iif({patientAge} > 60, 1, 0) + iif({vte_bmi} > 30, 1, 0), '')",
          "bands": [
            {
              "id": "b_none",
              "label": "No thrombosis risk factors ticked",
              "max": 0
            },
            {
              "id": "b_risk",
              "label": "Thrombosis risk: consider thromboprophylaxis"
            }
          ]
        },
        {
          "type": "expression",
          "name": "vte_bleeding",
          "title": "Bleeding risk factors",
          "calcKind": "custom",
          "expression": "iif(allAnswered('vte_active_bleeding', 'vte_acquired_bleeding', 'vte_anticoagulant', 'vte_stroke', 'vte_platelets', 'vte_hypertension', 'vte_inherited_bleeding', 'vte_neuro_spinal_eye', 'vte_high_bleeding', 'vte_lp_next_12h', 'vte_lp_last_4h'), score('vte_active_bleeding', 'vte_acquired_bleeding', 'vte_anticoagulant', 'vte_stroke', 'vte_platelets', 'vte_hypertension', 'vte_inherited_bleeding', 'vte_neuro_spinal_eye', 'vte_high_bleeding', 'vte_lp_next_12h', 'vte_lp_last_4h'), '')",
          "format": "Bleeding risk factors: {0}"
        }
      ]
    }
