{
  // vite.config.ts runs in Node, so it gets Node's types; the browser code (tsconfig.json) doesn't,
  // so \`process.env\` in src/ fails the type check instead of crashing in the browser.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
