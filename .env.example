DATABASE_URL=postgres://sj:sj@localhost:5432/sj?sslmode=disable
# Signs the stub login token. Any long random string for local dev.
TOKEN_SECRET=change-me-local-dev-secret
API_ADDR=:8080
# The stub sign-in (/api/dev/…) is off unless DEV_LOGIN=true. make dev turns it on. It's local
# only: on AWS staff sign in with Cognito (S12) and the API refuses DEV_LOGIN with CONFIG_STRICT.
# DEV_LOGIN=true
# Cognito's staff user pool (S12): set on AWS from SSM; locally leave them unset (the dev login
# stands in). All three or none. (STAFF_POOL_*, not COGNITO_*, so another project's .env values
# can't be picked up.)
# STAFF_POOL_ID=<region>_AbCdEf123
# STAFF_POOL_CLIENT_ID=
# STAFF_POOL_DOMAIN=https://<prefix>.auth.<region>.amazoncognito.com
# Patients' texts and emails: "capture" (the default, and the only mode until S17) stores them
# in sent_messages instead of sending them; read them at http://localhost:3000/qa/messages.
# MESSAGING=capture
# The scheduled jobs (reminders, "not responding"): make dev's API runs them every minute unless
# this is false. Run them as of a later time at http://localhost:3000/qa/jobs.
# JOBS_TIMER=true

# Per-country values (A-20). Local dev falls back to the UK; with CONFIG_STRICT=true (AWS)
# a missing one stops the server. Only apps/api/internal/config reads them.
# APP_URL=http://localhost:3000
# DEFAULT_TIME_ZONE=Europe/London
# DEFAULT_LOCALE=en-GB
# PHONE_COUNTRY=GB
# NATIONAL_ID_TYPE=nhs
# CONFIG_STRICT=false
# make test-integration: an admin connection to the same Postgres. Each test gets its own
# database, copied from a migrated template, so this names `postgres`, not `sj`.
TEST_DATABASE_URL=postgres://sj:sj@localhost:5432/postgres?sslmode=disable
# make e2e: the app the journeys run against (default http://localhost:3000, i.e. make dev).
# E2E_BASE_URL=http://localhost:3000
