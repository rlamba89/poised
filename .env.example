DATABASE_URL=postgres://sj:sj@localhost:5432/sj?sslmode=disable
API_ADDR=:8080
# Optional session limits (Go durations). Defaults: 8h after sign-in, 30m without a request.
# SESSION_MAX_AGE=8h
# SESSION_IDLE=30m
# Local development only. The stub sign-in (/api/dev/*) is off unless this is "true".
DEV_LOGIN=true
# Cookies are Secure unless this is "false"; plain-HTTP localhost needs "false".
COOKIE_SECURE=false
# The web app's origin: writes from it pass the cross-site check behind the /api proxy.
APP_ORIGIN=http://localhost:3000
# Seals patient links so clinicians can see them again: 32 random bytes, base64
# (head -c 32 /dev/urandom | base64). Local development only; never reuse it elsewhere.
LINK_KEY=+oYrNtlcJ/N1kubqki7SvHBpR/azB49mlJM7UjMe9ho=
# Staff sign-in with Cognito (optional: without COGNITO_POOL_ID only the dev login works).
# Fill these from your user pool and app client; see docs/cognito.md.
# COGNITO_POOL_ID=eu-west-2_XXXXXXXXX
# COGNITO_CLIENT_ID=
# COGNITO_DOMAIN=https://<prefix>.auth.eu-west-2.amazoncognito.com
# COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
# COGNITO_LOGOUT_URI=http://localhost:3000/login
# Invites call Cognito with these AWS credentials (an SSO profile; run aws sso login when it expires).
# AWS_PROFILE=
# make test-integration: a maintenance database; each test creates and drops its own database.
TEST_DATABASE_URL=postgres://sj:sj@localhost:5432/postgres?sslmode=disable
