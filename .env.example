DATABASE_URL=postgres://sj:sj@localhost:5432/sj?sslmode=disable
# Signs the stub login token. Any long random string for local dev.
TOKEN_SECRET=change-me-local-dev-secret
API_ADDR=:8080
# The stub sign-in (/api/dev/…) is off unless DEV_LOGIN=true. make dev turns it on.
# DEV_LOGIN=true

# Per-country values (A-20). Local dev falls back to the UK; with CONFIG_STRICT=true (AWS)
# a missing one stops the server. Only apps/api/internal/config reads them.
# APP_URL=http://localhost:3000
# DEFAULT_TIME_ZONE=Europe/London
# DEFAULT_LOCALE=en-GB
# PHONE_COUNTRY=GB
# CONFIG_STRICT=false
# make test-integration: an admin connection to the same Postgres. Each test gets its own
# database, copied from a migrated template, so this names `postgres`, not `sj`.
TEST_DATABASE_URL=postgres://sj:sj@localhost:5432/postgres?sslmode=disable
# make e2e: the app the journeys run against (default http://localhost:3000, i.e. make dev).
# E2E_BASE_URL=http://localhost:3000
