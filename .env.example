DATABASE_URL=postgres://sj:sj@localhost:5432/sj?sslmode=disable
# Signs the stub login token. Any long random string for local dev.
TOKEN_SECRET=change-me-local-dev-secret
API_ADDR=:8080
# make test-integration: an admin connection to the same Postgres. Each test gets its own
# database, copied from a migrated template, so this names `postgres`, not `sj`.
TEST_DATABASE_URL=postgres://sj:sj@localhost:5432/postgres?sslmode=disable
